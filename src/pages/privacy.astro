---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSettings } from '../lib/site';

const s = await getSettings();
---
<BaseLayout
  title="Privacy — Polina Kuban"
  description="How this portfolio website handles your data: no cookies, no forms, no analytics."
  mode="design"
  page="privacy"
  header={{ variant: 'back', backHref: '/', backLabel: 'Home', center: 'Privacy' }}
>
  <article class="text">
    <h1>Privacy</h1>
    <section class="grid3 sec">
      <h2 class="label">Cookies</h2>
      <p class="span23">This website does not use cookies and does not ask you for any personal data. There are no forms: if you write to me, you do it from your own email.</p>
    </section>
    <section class="grid3 sec">
      <h2 class="label">Analytics</h2>
      <p class="span23">This website does not use analytics or tracking: visits are not counted, and nothing follows you across other websites.</p>
    </section>
    <section class="grid3 sec">
      <h2 class="label">Hosting</h2>
      <p class="span23">The site is hosted on GitHub Pages. When you visit it, GitHub logs your IP address for security purposes, as described in the <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener">GitHub Privacy Statement</a>.</p>
    </section>
    <section class="grid3 sec">
      <h2 class="label">Contact</h2>
      <p class="span23">Questions about your data: <a href={`mailto:${s.email}`}>{s.email}</a>.</p>
    </section>
  </article>
</BaseLayout>

<style>
  .text { padding: 1.5vw 3vw 6vw 2.5vw; font-size: clamp(15px, 1.35vw, 22px); line-height: 1.5; }
  h1 { font-family: var(--serif); font-weight: 400; font-size: 7.4vw; line-height: .9; margin: 1vw 0 3vw; }
  .sec { padding: 1.4vw 0 2.6vw; border-top: 1px solid var(--line); }
  .sec .label { padding-top: .3em; }
  a { text-decoration: underline; text-underline-offset: .25em; }
  @media (max-width: 767px) {
    .text { padding: 2vw 4vw 8vw; font-size: 16px; }
    h1 { font-size: 14vw; margin: 2vw 0 6vw; }
    .sec { padding: 4vw 0 6vw; }
  }
</style>
