---
import { getSettings } from '../lib/site';

// One top panel for every page; `active` is the part of the site the page belongs to
export interface Props {
  active?: 'design' | 'coordination' | 'about';
}

const { active } = Astro.props;
const s = await getSettings();
const role = active === 'design' ? s.designRole : active === 'coordination' ? s.coordinationRole : s.aboutRole;
const parts = [
  { key: 'design', label: 'Design', href: '/' },
  { key: 'coordination', label: 'Coordination', href: '/coordination' },
] as const;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
// the part's own home is the current page; on its cases the part is only the current section
const current = (p: (typeof parts)[number]) => (active !== p.key ? undefined : here === p.href ? 'page' : 'true');
---
<header class="site-header">
  <span class="left role">{role}</span>
  <nav class="center switch" aria-label="Portfolio" data-active={active === 'about' ? undefined : active}>
    {/* a shared element, so the browser slides it from one half to the other on navigation */}
    <span class="knob" aria-hidden="true" transition:name="switch-knob"></span>
    {parts.map((p) => (
      <a href={p.href} aria-current={current(p)} transition:name={`switch-${p.key}`}>
        {p.label}
      </a>
    ))}
  </nav>
  <div class="end">
    <a class="about" href="/about" aria-current={active === 'about' ? 'page' : undefined}>About</a>
    <button class="pill" type="button" data-contact-open>Contact me</button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 15;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2vw;
    padding: 2.2vw 3vw 1.6vw 2.5vw;
    background: var(--bg);
    font-size: clamp(13px, 1.05vw, 17px);
    transition: background-color .7s ease;
  }
  .center { justify-self: center; }

  /* Design | Coordination: a pill with a knob under the current part (spec §4.7) */
  .switch {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
    border: 1px solid var(--fg);
    border-radius: 999px;
    transition: border-color .7s ease;
  }
  .knob {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    border-radius: 999px;
    background: var(--fg);
  }
  .switch[data-active='coordination'] .knob { transform: translateX(100%); }
  /* About, Privacy and 404 belong to neither part */
  .switch:not([data-active]) .knob { display: none; }
  .switch a {
    position: relative;
    padding: .3em 1.2em;
    text-align: center;
    color: var(--mute);
    transition: color .3s;
  }
  .switch a:hover { color: var(--fg); }
  .switch a[aria-current] { color: var(--bg); }

  .end { justify-self: end; display: flex; align-items: center; gap: 1.8vw; }
  /* About looks the same on every page, its own included */
  .about { color: var(--mute); transition: color .3s; }
  .about:hover { color: var(--fg); }
  .pill {
    border: 1px solid var(--fg);
    border-radius: 999px;
    padding: .35em 1.1em;
    transition: background-color .3s, color .3s;
  }
  .pill:hover { background: var(--fg); color: var(--bg); }

  @media (max-width: 767px) {
    .site-header {
      grid-template-columns: 1fr;
      padding: 4vw 4vw 3vw;
      font-size: 14px;
    }
    .role { grid-row: 2; color: var(--mute); }
    .switch { justify-self: stretch; }
    /* About moves up to the name row (Spine) and Contact me becomes the floating button */
    .end { display: none; }
  }
</style>
