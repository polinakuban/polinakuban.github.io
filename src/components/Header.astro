---
export type Props =
  | { variant: 'nav'; role: string; active: 'design' | 'coordination' | 'about' }
  | { variant: 'back'; backHref: string; backLabel: string; center: string };

const props = Astro.props;
const parts = [
  { key: 'design', label: 'Design', href: '/' },
  { key: 'coordination', label: 'Coordination', href: '/coordination' },
] as const;
---
<header class="site-header">
  {props.variant === 'nav' ? (
    <>
      <span class="left role">{props.role}</span>
      <nav class="center switch" aria-label="Portfolio" data-active={props.active}>
        {/* a shared element, so the browser slides it from one half to the other on navigation */}
        <span class="knob" aria-hidden="true" transition:name="switch-knob"></span>
        {parts.map((p) => (
          <a href={p.href} aria-current={props.active === p.key ? 'page' : undefined} transition:name={`switch-${p.key}`}>
            {p.label}
          </a>
        ))}
      </nav>
    </>
  ) : (
    <>
      <a class="left back" href={props.backHref}>← {props.backLabel}</a>
      <span class="center mute">{props.center}</span>
    </>
  )}
  <div class="end">
    {props.variant === 'nav' && (
      <a class="about" href="/about" aria-current={props.active === 'about' ? 'page' : undefined}>About</a>
    )}
    <button class="pill" type="button" data-contact-open>Contact me</button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 15;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2vw;
    padding: 2.2vw 3vw 1.6vw 2.5vw;
    background: var(--bg);
    font-size: clamp(13px, 1.05vw, 17px);
    transition: background-color .7s ease;
  }
  .center { justify-self: center; }

  /* Design | Coordination: a pill with a knob under the current part (spec §4.7) */
  .switch {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
    border: 1px solid var(--fg);
    border-radius: 999px;
    transition: border-color .7s ease;
  }
  .knob {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    border-radius: 999px;
    background: var(--fg);
  }
  .switch[data-active='coordination'] .knob { transform: translateX(100%); }
  .switch[data-active='about'] .knob { display: none; }
  .switch a {
    position: relative;
    padding: .3em 1.2em;
    text-align: center;
    color: var(--mute);
    transition: color .3s;
  }
  .switch a:hover { color: var(--fg); }
  .switch a[aria-current='page'] { color: var(--bg); }

  .end { justify-self: end; display: flex; align-items: center; gap: 1.8vw; }
  .about { color: var(--mute); transition: color .3s; }
  .about:hover, .about[aria-current='page'] { color: var(--fg); }
  .about[aria-current='page'] { font-weight: 500; }
  .pill {
    border: 1px solid var(--fg);
    border-radius: 999px;
    padding: .35em 1.1em;
    transition: background-color .3s, color .3s;
  }
  .pill:hover { background: var(--fg); color: var(--bg); }

  @media (max-width: 767px) {
    .site-header {
      grid-template-columns: 1fr auto;
      padding: 4vw 4vw 3vw;
      font-size: 14px;
    }
    .role { grid-column: 1 / -1; grid-row: 2; color: var(--mute); }
    .center { justify-self: end; }
    .switch { grid-column: 1 / -1; justify-self: stretch; }
    /* About moves up to the name row (Spine) and Contact me becomes the floating button */
    .end { display: none; }
  }
</style>
