---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'archive'>[];
}

const { items } = Astro.props;
const sets = await Promise.all(
  items
    .filter((it) => it.data.images.length)
    .map(async (it) => ({
      slug: it.id,
      title: it.data.title,
      images: await Promise.all(
        it.data.images.map(async (img) => ({ src: (await getImage({ src: img.src, width: 1600 })).src, alt: img.alt })),
      ),
    })),
);
---
{sets.map((set) => (
  <template data-set={set.slug} data-title={set.title}>
    {set.images.map((img) => (
      <div class="slide"><img src={img.src} alt={img.alt} loading="lazy" /></div>
    ))}
  </template>
))}
<div id="lightbox" role="dialog" aria-modal="true" aria-labelledby="lightbox-title" inert>
  <div class="bar">
    <span id="lightbox-title" data-lightbox-title></span>
    <span data-lightbox-count></span>
    <button type="button" data-lightbox-close>(Close)</button>
  </div>
  <div class="track" data-lightbox-track></div>
  <button type="button" class="arrow prev" data-lightbox-prev aria-label="Previous image">←</button>
  <button type="button" class="arrow next" data-lightbox-next aria-label="Next image">→</button>
</div>
<script>
  import '../scripts/lightbox';
</script>

<style>
  #lightbox {
    position: fixed;
    inset: 0;
    z-index: 55;
    display: flex;
    flex-direction: column;
    background: #121212;
    color: #f1efe9;
    opacity: 0;
    visibility: hidden;
    transition: opacity .35s, visibility 0s .35s;
  }
  :global(html.lightbox-open) #lightbox { opacity: 1; visibility: visible; transition: opacity .35s, visibility 0s; }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; padding: 2.2vw 3vw; font-size: clamp(13px, 1.05vw, 17px); }
  .bar button { justify-self: end; text-decoration: underline; text-underline-offset: .3em; }
  .track {
    flex: 1;
    min-height: 0;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .track :global(.slide) {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 8vw 4vw;
  }
  .track :global(img) { max-width: 100%; max-height: 100%; object-fit: contain; }
  .arrow { position: absolute; top: 50%; transform: translateY(-50%); font-size: 2vw; padding: 1vw; }
  .arrow[hidden] { display: none; }
  .prev { left: 2vw; }
  .next { right: 2vw; }

  @media (max-width: 767px) {
    .bar { padding: 5vw 4vw; font-size: 14px; }
    .track :global(.slide) { padding: 0 4vw 10vw; }
    .arrow { display: none; }
  }
</style>
