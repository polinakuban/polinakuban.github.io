---
interface Props {
  /** The home pages show the credit on desktop, About shows it on phones */
  on: 'desktop' | 'mobile';
}

const { on } = Astro.props;
---
<footer class:list={['site-foot label', on]}>
  <a href="https://sashagrigori.github.io/" target="_blank" rel="noopener">Site by Aleksandra Zianchurina ↗</a>
</footer>

<style>
  /* a band at the foot of the one-screen home layout, under the works */
  .site-foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 3vw;
    padding: 0 3vw 0 2.5vw;
  }
  .site-foot.mobile { display: none; }
  a:hover { color: var(--fg); text-decoration: underline; text-underline-offset: .25em; }

  @media (max-width: 767px) {
    .site-foot.desktop { display: none; }
    /* centred under the Contact button, which ends the page on phones */
    .site-foot.mobile { display: flex; justify-content: center; height: auto; padding: 4vw 4vw 6vw; font-size: 13px; }
  }
</style>
