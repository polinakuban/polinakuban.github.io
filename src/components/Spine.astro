---
import type { PageKind } from '../lib/types';

interface Props {
  page: PageKind;
  /** Pages with the Design | Coordination header: on phones their About link moves up to the name row */
  nav: boolean;
}

const { page, nav } = Astro.props;
---
<!-- the name is about Polina, so it leads to About -->
<a class="spine" href="/about" aria-label="About Polina Kuban" transition:name="spine">
  <span class="spine-text">POLINA<em>kuban</em></span>
</a>
<div class="top-mobile">
  <a class:list={['name-mobile', { 'is-home': page === 'home' }]} href="/about" aria-label="About Polina Kuban">
    POLINA<em>kuban</em>
  </a>
  {nav && (
    <a class="mobile-about" href="/about" aria-current={page === 'about' ? 'page' : undefined}>About</a>
  )}
</div>

<style>
  .spine {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--spine-w);
    border-right: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
  }
  .spine-text,
  .name-mobile {
    font-weight: 500;
    letter-spacing: -.04em;
    line-height: .85;
    white-space: nowrap;
  }
  .spine-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: min(10.6vw, 15.5vh);
  }
  .top-mobile { display: none; }

  @media (max-width: 767px) {
    .spine { display: none; }
    .top-mobile {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 4vw;
      padding: 5vw 4vw 0;
    }
    .name-mobile {
      min-width: 0;
      font-size: 11vw;
      /* the fallback serif is wider than Instrument Serif; never let it push the page sideways */
      overflow: hidden;
    }
    /* as large as it can be with About still fitting beside it */
    .name-mobile.is-home { font-size: 13.5vw; }
    .mobile-about { flex: none; font-size: 14px; color: var(--mute); transition: color .3s; }
    .mobile-about:hover, .mobile-about[aria-current='page'] { color: var(--fg); }
    .mobile-about[aria-current='page'] { font-weight: 500; }
  }
</style>
